{
  "editor.fontFamily": "Hack Nerd Font Mono, Menlo, Monaco, 'Courier New', monospace",
  "github.copilot.nextEditSuggestions.enabled": true,
  "git.autofetch": true,
  "diffEditor.renderSideBySide": false,
  "git.confirmSync": false,
  "redhat.telemetry.enabled": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "files.autoSaveWorkspaceFilesOnly": true,
  "files.autoSaveWhenNoErrors": true,
  "files.autoSave": "afterDelay",
  "vitest.cliArguments": " --config vite.renderer.config.ts --coverage",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "vue": true,
    "typescript": true,
  },
  "diffEditor.experimental.showMoves": true,
  "chat.viewSessions.orientation": "stacked",
  "editor.tabSize": 2,
  "files.autoSaveDelay": 3000,
  "diffEditor.ignoreTrimWhitespace": false,
  "vitest.workspaceConfig": "vitest.config.ts",
  "vitest.rootConfig": "vitest.config.ts",
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "git.replaceTagsWhenPull": true,
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev/schemas/2.5.1/schema.json": true,
    "https://biomejs.dev": true,
  },
  "editor.formatOnSave": true,
  "vue.autoInsert.dotValue": true,
  "workbench.browser.searchEngine": "duckduckgo",
  "workbench.colorTheme": "Calmppuccin Frappé",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "makefile.configureOnOpen": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,
}
